# SeqMaestro's credentials: a template.
#
# Copy it to `.env` and fill it in. `./install.sh` makes the copy where there is no `.env` yet.
# `.env` is ignored by git. This template is committed so that the variables a run needs can be
# seen without a secret being exposed.
#
#     cp .env.example .env
#
# A run reads these from its environment, so export them in the shell that starts it:
#
#     set -a && source .env && set +a
#
# The command line (`seqmaestro run`) reads this file itself, and keeps any variable the shell has
# already set.
#
# `./install.sh --check-llm` makes one call with them and says whether the model answers.
# README.md, step 2, says where each value is found.
#
# The live tests of the vendored methods (`methods/deft/tests/`, `methods/igsr/tests/`) load the
# file themselves, and skip where it is absent.
#
# None of this is needed for a run in which no arm's pool holds a written source and the judge is
# off, because the arms on fixed sources, the reduction, the reliability panel, the reveal and the
# report's inputs do not call a language model. The driver says which stages need the credentials
# before it starts any.

# ---------------------------------------------------------------------------------------
# The language model: one provider and one model, for every part that calls one
# ---------------------------------------------------------------------------------------
#
# Read by the proposer, the judge and the recurrence analysis (`seqmaestro/llm/client.py`), and by
# DEFT and IGSR, each through a config of its own for the provider named here. One model serves
# all of them, so that arms are compared on the same model and the judge scores every arm with it.
# Every call goes through LiteLLM.

# Which provider a run calls: azure, azure_foundry, openai or claude. Fill in that provider's block
# below. The other blocks can stay empty.
SEQMAESTRO_LLM_PROVIDER=

# --- azure: an Azure OpenAI deployment ---------------------------------------------------

# The API key of the Azure OpenAI resource.
SEQMAESTRO_AZURE_OPENAI_KEY=

# The resource's endpoint, with the trailing slash.
# e.g. https://my-resource-name.openai.azure.com/
SEQMAESTRO_AZURE_OPENAI_ENDPOINT=

# The name of the deployment in Azure, which may differ from the name of the model behind it.
SEQMAESTRO_AZURE_OPENAI_DEPLOYMENT=

# Optional. The model family behind the deployment, as a LiteLLM model string. A deployment's
# name is not in any model map, so LiteLLM needs this to know what the model supports, and that is
# what lets `reasoning_effort` through. Left unset, it is `azure/gpt-5.4`.
# `seqmaestro/llm/client.py` and DEFT's config read it. IGSR does not need it, since it tells
# LiteLLM to pass the effort on. Set it when the deployment moves to another family.
# SEQMAESTRO_AZURE_OPENAI_BASE_MODEL=azure/gpt-5.4

# The API version, which must be one the deployment supports. Reasoning models need
# 2025-04-01-preview or later. The same value is used when this is unset.
SEQMAESTRO_AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- azure_foundry: a model deployed on Azure AI Foundry -------------------------------------
#
# Such a model (the open models Kimi and DeepSeek, for example) is called through the resource's
# model inference API. Every call turns the model's reasoning off, since a model that reasons can
# spend its whole reply on reasoning (`seqmaestro/llm/client.py`).

# The API key of the Azure AI Foundry resource.
SEQMAESTRO_AZURE_FOUNDRY_KEY=

# The resource's endpoint. The target URI the portal shows for a deployment will do as it is.
# e.g. https://my-resource-name.services.ai.azure.com/
SEQMAESTRO_AZURE_FOUNDRY_ENDPOINT=

# The name of the deployment, as the portal lists it under Deployments.
SEQMAESTRO_AZURE_FOUNDRY_DEPLOYMENT=

# --- openai: the OpenAI API -------------------------------------------------------------

# An API key of the OpenAI platform.
SEQMAESTRO_OPENAI_KEY=

# The model's name as the API lists it.
# e.g. gpt-5.4
SEQMAESTRO_OPENAI_MODEL=

# --- claude: the Claude API -------------------------------------------------------------

# An API key of the Claude Console. Its name begins with SEQMAESTRO_, as every setting of the
# language model's does, so that an agent harness does not take it for its own: Claude Code would
# bill a key named ANTHROPIC_API_KEY for the agent's own work.
SEQMAESTRO_CLAUDE_KEY=

# The model's name as the API lists it.
# e.g. claude-sonnet-5-5
SEQMAESTRO_CLAUDE_MODEL=

# ---------------------------------------------------------------------------------------
# Optional, for parts of the repository a run of the pipeline does not need
# ---------------------------------------------------------------------------------------

# A topic on ntfy.sh. With it set, the driver sends a notification when a stage fails and when a
# run ends. Anyone who knows the topic's name can read what is sent to it, so choose one that
# cannot be guessed, and keep it out of every tracked file.
# NTFY_TOPIC=

# AlphaGenome's API key, for `experiments/prepare/predict_alphagenome_summaries.py`. The script is
# told the variable's name with `--key-variable`, so any name will do.
# ALPHAGENOME_API_KEY=

# The interpreters of the other conda environments are looked for under the conda installation of
# the interpreter that runs the pipeline. A machine that keeps them elsewhere names each one with
# `SEQMAESTRO_PYTHON_<ENVIRONMENT>`, as `ENVIRONMENTS.md` shows.
