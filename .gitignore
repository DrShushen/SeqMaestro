# === Custom ===
.dev/
.vscode/

CLAUDE.md
style.md
# ^ Both not committed on purpose.

# Anchored to the repo root. A bare `data/` matches at any depth, which also swallowed
# `methods/deft/src/data/` is the dataset-plugin source code, not data.
/data/

# Vendored methods keep their own datasets on disk but out of git.
methods/*/data/

# What belongs to one dataset stays on the machine that holds the dataset, as `data/` does: its
# builder and split scripts, its declaration, the description the models are told, its run
# configs, a hand-written prompt config, and the tests of its builder. Each folder below is
# ignored but for the files named after it, so a new dataset's files are ignored without a line
# here. What the repository holds is the shared configs, the tools every dataset uses, and one
# example dataset (`experiments/prepare/README.md`).
/experiments/configs/*.yaml
!/experiments/configs/_shared.yaml
!/experiments/configs/_shared_continuous.yaml
!/experiments/configs/_motifs.yaml
!/experiments/configs/example.yaml
!/experiments/configs/example_quick.yaml
!/experiments/configs/example_motifs.yaml

/experiments/datasets/*.json
!/experiments/datasets/example.json

/experiments/prepare/*.py
!/experiments/prepare/build_example_dataset.py
!/experiments/prepare/check_sequence_provenance.py
!/experiments/prepare/design_power.py
!/experiments/prepare/fetch_motif_collection.py
!/experiments/prepare/finalise_dataset.py
!/experiments/prepare/predict_alphagenome_summaries.py
!/experiments/prepare/write_group_map.py

/experiments/prepare/declarations/*.yaml
!/experiments/prepare/declarations/example__splits.yaml

# Notes on this machine's datasets, kept beside the scripts that built them.
/experiments/prepare/LOCAL_DATASETS.md

/experiments/adapters/deft_conf/params_generation/*.yaml

/tests/test_local_*.py

# Run records in full: git carries the scripts that produce a run, not the runs. A run record
# is therefore the only copy of its own numbers, so copy anything worth citing somewhere durable.
experiments/runs/

# Session ephemera: a draft commit message, and the handover written before a context
# compaction.
/commit.txt
/continue.md

workdir/
workdir_reporting/

# Code and outputs used only to compare SeqMaestro with other methods (black-box models,
# motif discovery), for the paper. None of it is part of SeqMaestro.
/baselines/

# Claude Code: a user's own settings for this repository. The skill and the shared settings under
# .claude/ are tracked.
.claude/settings.local.json
